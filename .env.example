# ---- Podstawowe ----
DATABASE_URL=postgresql://...
NEXTAUTH_SECRET=              # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=https://twoja-domena.vercel.app

# ---- Discord: aplikacja (Developer Portal -> Twoja aplikacja) ----
DISCORD_CLIENT_ID=            # General Information -> Application ID
DISCORD_CLIENT_SECRET=        # OAuth2 -> Client Secret (logowanie i powiązanie konta)
DISCORD_PUBLIC_KEY=           # General Information -> Public Key (weryfikacja komend bota)
DISCORD_BOT_TOKEN=            # Bot -> Token (wiadomości prywatne, role, rejestracja komend)
DISCORD_GUILD_ID=             # ID serwera (prawy przycisk na serwerze -> Kopiuj ID)

# ---- Discord: webhooki kanałów (Edytuj kanał -> Integracje -> Webhooki) ----
# Każdy kanał może mieć własny webhook; brakujące używają DISCORD_WEBHOOK_URL (jeśli ustawiony).
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_REKRUTACJA=
DISCORD_WEBHOOK_WNIOSKI=
DISCORD_WEBHOOK_USTERKI=
DISCORD_WEBHOOK_RAPORTY=
DISCORD_WEBHOOK_WIADOMOSCI=
DISCORD_WEBHOOK_GRAFIK=
DISCORD_WEBHOOK_KONTAKT=

# ---- Discord: role na serwerze (ID ról; puste = pomijane) ----
DISCORD_ROLE_WLASCICIEL=
DISCORD_ROLE_DYSPOZYTOR=
DISCORD_ROLE_KIEROWNIK=
DISCORD_ROLE_MECHANIK=
DISCORD_ROLE_SPRAWDZAJACY=
DISCORD_ROLE_KIEROWCA=
DISCORD_ROLE_VMPK=
DISCORD_ROLE_VBP=
